[init]
	defaultBranch = main
[credential]
	helper = cache --timeout 21600
	helper = oauth
[user]
	name = Jamie
	email = jamie.giarratana@gmail.com
[alias]
	go = log --graph --all --oneline --decorate
	mt = mergetool
[diff]
  tool = nvimdiff
[difftool "nvimdiff"]
  cmd = nvim -d $LOCAL $REMOTE
  trustExitCode = true
  keepBackup = false
[merge]
  tool = nvimdiff
[mergetool "nvimdiff"]
  path = nvim
  cmd = nvim -d $LOCAL $REMOTE
  trustExitCode = true
