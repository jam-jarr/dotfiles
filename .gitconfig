[core]
  pager = delta
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
  dark = true
[init]
	defaultBranch = main
[user]
	name = Jamie
	email = jamie.giarratana@gmail.com
[alias]
	go = log --graph --all --oneline --decorate
	mt = mergetool
[diff]
  tool = nvimdiff
[difftool "nvimdiff"]
  cmd = nvim -d $LOCAL $REMOTE
  trustExitCode = true
  keepBackup = false
[merge]
  tool = nvimdiff
[mergetool "nvimdiff"]
  path = nvim
  cmd = nvim -d $LOCAL $REMOTE
  trustExitCode = true
[github]
	user = jam-jarr
